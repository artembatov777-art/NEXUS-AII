{
  "name": "nexus-au",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "node server/railway.js",
    "test": "npm run check:cli && npm run build:cli --silent && node --test cli/nexus.node-test.js && vitest run && node --test server/railway.node-test.js",
    "test:watch": "vitest",
    "test:railway": "node --test server/railway.node-test.js",
    "tauri": "tauri",
    "build:pages": "tsc -b && vite build --mode pages",
    "check:workflow-pins": "node scripts/verify-workflow-action-pins.mjs",
    "cli": "npm run build:cli --silent && node build-cli/nexus.js",
    "build:cli": "esbuild cli/nexus.ts --bundle --platform=node --format=esm --target=node20 --outfile=build-cli/nexus.js",
    "prepack": "npm run build:cli",
    "check:cli": "tsc --noEmit --strict --skipLibCheck --target ES2022 --module ESNext --moduleResolution bundler --resolveJsonModule --esModuleInterop cli/nexus.ts cli/agent.ts cli/permissions.ts cli/workspace.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.9.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.5.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "typescript": "~5.7.2",
    "vite": "^6.4.6",
    "vitest": "^4.1.12"
  },
  "bin": {
    "nexus": "./build-cli/nexus.js"
  },
  "files": [
    "build-cli",
    "README.md"
  ]
}
