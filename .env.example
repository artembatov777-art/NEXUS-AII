# Never commit real API keys or tokens. Configure these in Vercel Project Settings -> Environment Variables.
# The browser sends only NEXUS_API_TOKEN to the server-side gateway. Provider keys remain server-side.
NEXUS_API_TOKEN=
GEMINI_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
SAMBANOVA_API_KEY=
NVIDIA_API_KEY=
# Optional: public deployment URL used as the OpenRouter HTTP-Referer.
NEXUS_PUBLIC_URL=
